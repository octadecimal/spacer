{
    "name": "client",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/client/src",
    "projectType": "application",
    "targets": {
        "build": {
            "executor": "@nx/vite:build",
            "outputs": [
                "{options.outputPath}"
            ],
            "defaultConfiguration": "production",
            "options": {
                "outputPath": "packages/client/dist"
            },
            "configurations": {
                "development": {
                    "mode": "development"
                },
                "production": {
                    "mode": "production"
                }
            }
        },
        "serve": {
            "executor": "@nx/vite:dev-server",
            "defaultConfiguration": "development",
            "options": {
                "buildTarget": "client:build"
            },
            "configurations": {
                "development": {
                    "buildTarget": "client:build:development",
                    "hmr": true
                },
                "production": {
                    "buildTarget": "client:build:production",
                    "hmr": false
                }
            }
        },
        "preview": {
            "executor": "@nx/vite:preview-server",
            "defaultConfiguration": "development",
            "options": {
                "buildTarget": "client:build"
            },
            "configurations": {
                "development": {
                    "buildTarget": "client:build:development"
                },
                "production": {
                    "buildTarget": "client:build:production"
                }
            }
        },
        "test": {
            "executor": "@nx/vite:test",
            "outputs": [
                "{options.reportsDirectory}"
            ],
            "options": {
                "passWithNoTests": true,
                "reportsDirectory": "../../coverage/packages/client"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": [
                "{options.outputFile}"
            ],
            "options": {
                "lintFilePatterns": [
                    "packages/client/**/*.{ts,tsx,js,jsx}"
                ]
            }
        },
        "cap:sync": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx cap sync",
                "cwd": "packages/client"
            }
        },
        "cap:build": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "nx build client",
                    "nx cap:sync client"
                ],
                "parallel": false
            }
        },
        "cap:android": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx cap run android --target=29141FDH300L6T",
                "cwd": "packages/client"
            }
        },
        "cap:ios": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx cap run ios",
                "cwd": "packages/client"
            }
        },
        "cap:android:dev": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "nx cap:build client",
                    "nx cap:android client"
                ],
                "parallel": false
            }
        },
        "cap:ios:dev": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "nx cap:build client",
                    "nx cap:ios client"
                ],
                "parallel": false
            }
        },
        "cap:clean": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx cap clean",
                "cwd": "packages/client"
            }
        },
        "cap:open:android": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx cap open android",
                "cwd": "packages/client"
            }
        },
        "cap:open:ios": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx cap open ios",
                "cwd": "packages/client"
            }
        }
    },
    "tags": []
}